#include<iostream>
#include "button.h"
#include "raylib.h"
#include<string>

Button::Button(float width, float height, float posX, float posY, Color color) : width(width), height(height), posX(posX), posY(posY), color(color){
    rec = {posX, posY, width, height};
}

void Button::drawButton(){
    
    DrawRectangleRec(rec, color);

    std::cout << rec.x << '\n';
    
}

void Button::drawButtonText(Font font, std::string text, std::string horAllign, std::string vertAllign, Color textColor){
    
    
    std::cout << textDimensions.x << " " << textDimensions.y << '\n';
    
    std::cout << text.c_str() << '\n';
    std::cout << fontSize << '\n';
    

    //if(textDimensions.x == 0.0f && textDimensions.y == 0.0f){
    //    fontSize += 5.0f;
    //    if(MeasureTextEx(font, text.c_str(), fontSize, 1.0f).x > width * 0.9f || MeasureTextEx(font, text.c_str(), fontSize, 1.0f).y > height * 0.9f){
    //        fontSize -= 3.0f;
            textDimensions = MeasureTextEx(font, text.c_str(), fontSize, 1.0f);
    //    }
    }else{
        if(textPosition.x == 0.0f && textPosition.y == 0.0f){
            if(horAllign == "center"){
                textPosition.x = posX + (width - textDimensions.x)/2.0f;
            }
            if(vertAllign == "center"){
                textPosition.y = posY + (height - textDimensions.y)/2.0f;
            }
        }else{
            DrawRectangleRec(rec, color);
            DrawTextEx(font, text.c_str(), textPosition, fontSize, 1.0f, textColor);
        }
    }
}

bool Button::isClicked(){
    
    if(CheckCollisionPointRec(GetMousePosition(), rec)){
        if(IsMouseButtonPressed(MOUSE_BUTTON_LEFT)){
            return true;
        }
    }
    
    return false;

}
